#!/usr/bin/env bash
# Is the user at their terminal, or driving this session remotely?
#
# Prints "terminal" or "phone" and exits 0; "unknown" and exits 1 when there is
# nothing to read.
#
# The test is whether this terminal has been touched at all lately, sampled at the
# moment a prompt arrives. Submitting a prompt from the terminal means pressing
# Enter inside tmux, which bumps that client's #{client_activity}. A prompt
# arriving over Remote Control enters the process by its messaging socket and never
# touches the tmux client, so the stamp stops advancing for as long as the user is
# away. Asked when a prompt lands, "has this terminal been touched lately?"
# separates the two.
#
# The window is MINUTES and deliberately generous. It is not documented which tmux
# events stamp client_activity -- keystrokes inside a full-screen TUI may not all
# do -- so a tight window would call someone away merely for reading their own
# screen quietly. The remote case does not need a tight window: staleness there
# grows without bound. Err toward "terminal"; that error costs a few minutes of a
# remote session without phone mode, while the opposite one hides the tracker pane
# from someone sitting in front of it.
#
# A machine with no tmux server running -- a cloud VM, for instance -- has no
# attached client and so reads as "phone", which is correct: such a session is
# always being driven remotely.

set -uo pipefail

WINDOW="${PHONE_PRESENCE_WINDOW:-300}"  # seconds; see note above on erring long

command -v tmux >/dev/null 2>&1 || { echo unknown; exit 1; }

now=$(date +%s)
freshest=""
while read -r act; do
  [ -n "$act" ] || continue
  if [ -z "$freshest" ] || [ "$act" -gt "$freshest" ]; then freshest="$act"; fi
done < <(tmux list-clients -F '#{client_activity}' 2>/dev/null)

# No attached client at all: nobody is sitting at this terminal.
[ -n "$freshest" ] || { echo phone; exit 0; }

delta=$(( now - freshest ))
# Always report the delta on stderr: the hook logs it, and the window wants
# tuning against real data rather than guesswork.
echo "delta=${delta}s window=${WINDOW}s" >&2

[ "$delta" -le "$WINDOW" ] && echo terminal || echo phone
exit 0
