#!/usr/bin/env bash
# Hide the quest-tracker tmux pane while phone mode is on, and put it back after.
#
# On the phone the pane is not just useless, it is harmful: Remote Control mirrors
# the session's PTY, so the 37 columns the pane eats come straight out of the width
# the reply gets on a phone screen. The pane's content rides in the reply instead
# (see SKILL.md), so nothing is lost by killing it.
#
# Idempotent in both directions and safe to call every turn -- `hide` does nothing
# if already hidden, `show` does nothing unless *we* were the one who hid it. That
# matters: phone mode is recomputed per turn, so these run constantly, and a pane
# the user closed himself must stay closed.
#
# Silent and always exit 0. This is a nicety; it must never break a turn.
set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/claude-phone"
STATE="$STATE_DIR/hidden-panes"
PANE_RE='quest-pane|tangent-pane'

command -v tmux >/dev/null 2>&1 || exit 0
tmux has-session 2>/dev/null || exit 0

case "${1:-status}" in
  hide)
    mkdir -p "$STATE_DIR" 2>/dev/null
    # Record window + width + start command before killing, so `show` can rebuild
    # the pane exactly as it was rather than guessing at ensure-pane.sh's defaults.
    tmux list-panes -a -F '#{pane_id}|#{window_id}|#{pane_width}|#{pane_start_command}' 2>/dev/null |
      while IFS='|' read -r pane window width cmd; do
        [[ "$cmd" =~ $PANE_RE ]] || continue
        cmd="${cmd%\"}"; cmd="${cmd#\"}"
        printf '%s|%s|%s\n' "$window" "$width" "$cmd" >> "$STATE"
        tmux kill-pane -t "$pane" 2>/dev/null
      done
    ;;

  show)
    [ -s "$STATE" ] || exit 0
    while IFS='|' read -r window width cmd; do
      [ -n "$window" ] && [ -n "$cmd" ] || continue
      # Someone (a new session's ensure-pane.sh, most likely) may have already put
      # one back in that window. Two panes would be worse than none.
      tmux list-panes -t "$window" -F '#{pane_start_command}' 2>/dev/null |
        grep -qE "$PANE_RE" && continue
      tmux split-window -h -l "${width:-37}" -d -t "$window" "$cmd" 2>/dev/null &&
        tmux select-pane -L -t "$window" 2>/dev/null
    done < "$STATE"
    rm -f "$STATE"
    ;;

  status)
    [ -s "$STATE" ] && echo hidden || echo visible
    ;;
esac
exit 0
